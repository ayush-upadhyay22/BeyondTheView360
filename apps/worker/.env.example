# ---- BeyondTheView360 worker — local development defaults ----
# Copy to .env to override. If .env is missing, these defaults are used automatically
# (only when NODE_ENV is not "production").

NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://btv:btv_local_password@localhost:5432/btv
REDIS_URL=redis://localhost:6379

STORAGE_DRIVER=s3
S3_BUCKET=btv-media
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=btvminio
S3_SECRET_ACCESS_KEY=btv_minio_local_secret

# Processing (QUEUE_PREFIX must match the API's)
QUEUE_PREFIX=btv
WORKER_CONCURRENCY=2
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
# Largest accepted input (width*height). 16384x8192 = 134M.
MAX_INPUT_PIXELS=268435456
# Scenes stuck in queued/processing longer than this are re-enqueued
STUCK_SCENE_MINUTES=15
SWEEP_INTERVAL_SECONDS=60
# Uploads presigned but never completed are deleted after this many hours
PENDING_UPLOAD_TTL_HOURS=24
