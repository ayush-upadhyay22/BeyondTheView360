# ---- BeyondTheView360 API — local development defaults ----
# Copy to .env to override. If .env is missing, these defaults are used automatically
# (only when NODE_ENV is not "production").

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres / Redis (docker-compose.yml)
DATABASE_URL=postgres://btv:btv_local_password@localhost:5432/btv
REDIS_URL=redis://localhost:6379

# Browser origins allowed to call the API with credentials (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public origin of the web app (used to build share links and embed snippets)
WEB_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY=0

# Sessions
SESSION_TTL_DAYS=30
# Defaults to true when NODE_ENV=production
COOKIE_SECURE=false

# Storage — "s3" driver works with MinIO locally and AWS S3 in production
STORAGE_DRIVER=s3
S3_BUCKET=btv-media
S3_REGION=us-east-1
# Leave S3_ENDPOINT empty for AWS S3
S3_ENDPOINT=http://localhost:9000
# Endpoint as seen by browsers (presigned uploads / signed URLs). Defaults to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=true
# Leave both empty in production to use the IAM role / default AWS credential chain
S3_ACCESS_KEY_ID=btvminio
S3_SECRET_ACCESS_KEY=btv_minio_local_secret
# Optional CDN in front of the bucket (e.g. https://cdn.example.com). When set, images are
# served from here instead of short-lived signed URLs.
PUBLIC_BASE_URL=
SIGNED_URL_TTL_SECONDS=3600
UPLOAD_URL_TTL_SECONDS=900

# Plan limits (see packages/core/src/plans.ts)
PLAN_FREE_MAX_TOURS=3
PLAN_FREE_MAX_SCENES_PER_TOUR=20
PLAN_FREE_MAX_UPLOAD_MB=100

# Request hardening
JSON_BODY_LIMIT=100kb
RATE_LIMIT_ENABLED=true

# Queue (QUEUE_PREFIX must match the worker's)
QUEUE_PREFIX=btv
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
