# ---- BeyondTheView360 — AWS Elastic Beanstalk / EC2 one-process host ----
# These are injected automatically from .ebextensions/ + aws/cloudformation.yml
# (via `eb create` / `eb setenv`). Copy only if you run the host on a raw EC2 box.

NODE_ENV=production
PORT=8080
LOG_LEVEL=info
TRUST_PROXY=1
COOKIE_SECURE=true

# RDS Postgres 16 (free-tier db.t3.micro / db.t4g.micro)
DATABASE_URL=postgres://btv:CHANGE_ME@YOUR_RDS_ENDPOINT:5432/btv?sslmode=require

# One-process host: no Redis / ElastiCache
QUEUE_DRIVER=inline

# S3 private bucket (IAM instance role; leave access keys empty)
STORAGE_DRIVER=s3
S3_BUCKET=beyond-the-view-360-ACCOUNT_ID
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_SECRET=generate-a-long-random-string
CSP_MEDIA_ORIGINS=https://YOUR_BUCKET.s3.amazonaws.com,https://YOUR_BUCKET.s3.us-east-1.amazonaws.com

# Public site origin (EB CNAME or custom domain) — required for cookies / CORS
WEB_ORIGIN=https://YOUR_ENV.REGION.elasticbeanstalk.com
CORS_ORIGINS=https://YOUR_ENV.REGION.elasticbeanstalk.com
AWS_APP_URL=https://YOUR_ENV.REGION.elasticbeanstalk.com

MIGRATE_ON_START=1
MAX_INPUT_PIXELS=16777216
SESSION_TTL_DAYS=30
RATE_LIMIT_ENABLED=true
EMBED_FRAME_ANCESTORS=*
