{
  "name": "@btv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "db:seed": "tsx scripts/seed.ts",
    "samples:upload": "tsx scripts/upload-samples.ts"
  },
  "dependencies": {
    "@btv/core": "*",
    "@btv/shared": "*",
    "@node-rs/argon2": "2.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "pino-http": "10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@btv/worker": "*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsup": "8.5.1"
  }
}
