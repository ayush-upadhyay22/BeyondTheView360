# ---- BeyondTheView360 web — local development defaults ----
# Vite loads .env automatically; copy this file to .env to change values.

# Base URL the browser uses for API calls. "/api" keeps everything same-origin
# (Vite proxies it in dev; put a reverse proxy / path rule in front in production).
VITE_API_BASE_URL=/api
# Dev-server proxy target for /api
VITE_API_PROXY_TARGET=http://localhost:4000

# ---- Production static server (apps/web/server/serve.ts) ----
WEB_PORT=8080
# Optional: proxy /api to this origin when you don't have a reverse proxy
API_PROXY_TARGET=
# Extra origins for CSP connect-src/img-src (S3 endpoint or CDN), comma separated
CSP_MEDIA_ORIGINS=http://localhost:9000
# Who may embed /embed/* pages in an iframe ("*" = anyone)
EMBED_FRAME_ANCESTORS=*
