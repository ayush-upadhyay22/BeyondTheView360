{
  "name": "@btv/core",
  "version": "0.1.0",
  "private": true,
  "description": "Server-only building blocks shared by the API and the worker: config, database, storage, queue.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run test/storage.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/s3-presigned-post": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "@btv/shared": "*",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0"
  }
}
