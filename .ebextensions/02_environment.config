# Application env + health checks for the free-tier single-instance host.
# Secrets / resource URLs (DATABASE_URL, S3_BUCKET, STORAGE_SECRET, WEB_ORIGIN, …)
# are set in the EB console or via `eb setenv` / CloudFormation outputs — not here.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: '8080'
    TRUST_PROXY: '1'
    COOKIE_SECURE: 'true'
    QUEUE_DRIVER: inline
    STORAGE_DRIVER: s3
    S3_FORCE_PATH_STYLE: 'false'
    MIGRATE_ON_START: '1'
    MAX_INPUT_PIXELS: '16777216'
    LOG_LEVEL: info
    SESSION_TTL_DAYS: '30'
    RATE_LIMIT_ENABLED: 'true'
    EMBED_FRAME_ANCESTORS: '*'
    # Leave Redis unused on the free one-process host.
    # Leave S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_ENDPOINT unset → instance IAM role.
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/healthz
    Port: '8080'
    Protocol: HTTP
