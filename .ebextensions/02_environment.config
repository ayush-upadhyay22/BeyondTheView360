# Application env injected into the EB environment at deploy/create time.
# Secrets and resource URLs (DATABASE_URL, S3_BUCKET, STORAGE_SECRET, WEB_ORIGIN)
# are set by aws/cloudformation.yml — or paste them in the EB console if you
# create the environment by hand.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    TRUST_PROXY: '1'
    COOKIE_SECURE: 'true'
    QUEUE_DRIVER: inline
    STORAGE_DRIVER: s3
    S3_FORCE_PATH_STYLE: 'false'
    S3_ENDPOINT: ''
    S3_ACCESS_KEY_ID: ''
    S3_SECRET_ACCESS_KEY: ''
    MIGRATE_ON_START: '1'
    MAX_INPUT_PIXELS: '16777216'
    LOG_LEVEL: info
    SESSION_TTL_DAYS: '30'
    RATE_LIMIT_ENABLED: 'true'
    EMBED_FRAME_ANCESTORS: '*'
    # Leave Redis unused on the free one-process host.
    # REDIS_URL is intentionally unset.
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/healthz
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/healthz
    Port: '8080'
    Protocol: HTTP
