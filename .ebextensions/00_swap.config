# 2 GB swap so npm/build/Sharp can finish on t3.micro (1 GB RAM) without freezing.
commands:
  00_enable_swap:
    command: |
      set -e
      if ! swapon --show | grep -q /var/swapfile; then
        if [ ! -f /var/swapfile ]; then
          /bin/dd if=/dev/zero of=/var/swapfile bs=1M count=2048
          /bin/chmod 600 /var/swapfile
          /sbin/mkswap /var/swapfile
        fi
        /sbin/swapon /var/swapfile
      fi
      /usr/bin/free -m
    ignoreErrors: true
