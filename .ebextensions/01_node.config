# Elastic Beanstalk — Node build/runtime for the monorepo one-process host.
option_settings:
  aws:elasticbeanstalk:container:nodejs:
    NodeCommand: 'node apps/api/dist/host.js'
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
  # CodePipeline deploys source → EB (no CodeBuild). Install devDeps so `npm run build` can run on the instance.
  aws:elasticbeanstalk:application:environment:
    NPM_USE_PRODUCTION: 'false'
