# Elastic Beanstalk — Node runtime for the monorepo one-process host.
# Start command comes from Procfile (`web: node apps/api/dist/host.js`).
# Do not set NodeCommand — unknown/duplicate on Node.js AL2023 platforms.
option_settings:
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
  # CodePipeline deploys source → EB (no CodeBuild). Install devDeps so predeploy can build.
  aws:elasticbeanstalk:container:nodejs:
    NPM_USE_PRODUCTION: 'false'
