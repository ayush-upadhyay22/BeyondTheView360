# Elastic Beanstalk Node.js on Amazon Linux 2023.
# Start command: Procfile → `web: node apps/api/dist/host.js`
# Do NOT use aws:elasticbeanstalk:container:nodejs (NodeCommand / NPM_USE_PRODUCTION) —
# those options exist only on retired Amazon Linux AMI platforms and fail validation.
option_settings:
  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx
